# ============================================
# 不上传的文件
# ============================================

# 报告 / 发言稿 / PPT 内容（不上传）
*.md
!README.md

# 训练输出（太大，通常 GB 级别）
output/
output_*/
*.ply

# VGGT 模型权重（几 GB）
vggt/models/*.pt
vggt/models/*.pth
**/model.pt
**/*.ckpt

# VGGT 推理产生的中间数据（可以由脚本重新生成）
vggt/examples/*/vggt/
vggt/examples/*/3dgs_input/sparse/
vggt/examples/*/3dgs_input/depths/
vggt/examples/*/3dgs_input/weights/
vggt/examples/*/3dgs_input/weights_appear/
vggt/examples/*/3dgs_input/images/

# 缓存 / 编译产物
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
*.egg-info/
build/
dist/

# 虚拟环境
venv/
env/
.conda/

# IDE
.vscode/
.idea/
*.swp
.DS_Store

# 日志 / 临时文件
*.log
*.tmp
*.bak
tmp/
log/

# 大型数据文件
*.npy
*.npz
*.mp4
*.avi

# 渲染结果
**/renders/
**/gt/

# 其他
.claude/
.anthropic/

# 压缩包（不上传）
*.rar
*.zip
*.tar
*.tar.gz
*.7z

# 3DGS 下载的示例数据集（太大，外部数据）
gaussian-splatting-main/datasets/

# 第三方库 / 构建产物（太大，可重新编译）
gaussian-splatting-main/submodules/*/build/
gaussian-splatting-main/submodules/*/third_party/
gaussian-splatting-main/submodules/**/*.egg-info/
**/third_party/

# VGGT 示例图片（保留 kitchen 5 张作为演示，其他排除以节省空间）
# 如果不想上传任何示例图片，取消下面的注释：
# vggt/examples/
