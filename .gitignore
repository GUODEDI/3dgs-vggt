# ============================================
# Files to exclude from git
# ============================================

# Markdown (local notes only; README allowed on GitHub)
*.md
!README.md
!**/README.md

# Papers / office documents (not uploaded)
*.pdf
*.docx
*.pptx

# Local comparison renders (GitHub demo image kept under results/)
comparison_visuals/
comparison_visuals_*/
comparison_visuals_full/
渲染对比/
*.png
!results/*.png
!gaussian-splatting-main/assets/**

# Prebuilt viewers (binaries)
viewers/

# Temp extraction outputs
_fit*.txt
_tagawa*.txt
_ppt_extract*.txt
_styles_out.txt
_template_paras.txt
_fitpaper*.txt

# Training outputs (usually GB-sized)
output/
output_*/
*.ply

# VGGT model weights (several GB)
vggt/models/*.pt
vggt/models/*.pth
**/model.pt
**/*.ckpt

# VGGT inference intermediate data (can be regenerated by scripts)
vggt/examples/*/vggt/
vggt/examples/*/3dgs_input/sparse/
vggt/examples/*/3dgs_input/depths/
vggt/examples/*/3dgs_input/weights/
vggt/examples/*/3dgs_input/weights_appear/
vggt/examples/*/3dgs_input/images/

# Cache / build artifacts
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
*.egg-info/
build/
dist/

# Virtual environments
venv/
env/
.conda/

# IDE
.vscode/
.idea/
*.swp
.DS_Store

# Logs / temp files
*.log
*.tmp
*.bak
tmp/
log/

# Large data files
*.npy
*.npz
*.mp4
*.avi

# Rendered results
**/renders/
**/gt/

# Other
.claude/
.anthropic/

# Archives (not uploaded)
*.rar
*.zip
*.tar
*.tar.gz
*.7z

# 3DGS downloaded example datasets (large external data)
gaussian-splatting-main/datasets/

# Third-party libraries / build artifacts (large, can be recompiled)
gaussian-splatting-main/submodules/*/build/
gaussian-splatting-main/submodules/*/third_party/
gaussian-splatting-main/submodules/**/*.egg-info/
**/third_party/

# VGGT example images (kept kitchen 5 images as demo; uncomment below to exclude all)
# vggt/examples/
